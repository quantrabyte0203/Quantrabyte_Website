# ---- Wall of Fame admin ----
# Password for /admin. Choose something long.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---- Contact form (existing feature) ----
# The Gmail app password used to be hardcoded in server.js and is therefore in
# git history. Rotate it in your Google Account, then put the new one here.
MAIL_USER=info@quantrabyte.com
MAIL_PASS=
MAIL_TO=info@quantrabyte.com

# ---- Server ----
PORT=5000
NODE_ENV=development
